# No quotes around values: kustomize keeps them as part of the value.
APP_URL=https://resume.example.com
TZ=Etc/UTC
FLAG_DISABLE_SIGNUPS=true

# Postgres (the same password goes in both lines; URL-safe characters only)
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
DATABASE_URL=postgresql://postgres:same-password-as-above@postgres:5432/postgres

AUTH_SECRET=generate-with-openssl-rand-hex-32

# Storage and Redis settings: copy the remaining keys from the upstream
# .env.example of your Reactive Resume version. Hosts must be the Service names:
#   Redis -> redis://redis:6379    S3 endpoint -> http://seaweedfs:8333
# Bucket name: reactive-resume
