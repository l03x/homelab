# No quotes around values: kustomize keeps them as part of the value.
# Keep the SAME value forever: every saved credential in the DB is encrypted with it.
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Public URL behind the tunnel (trailing slash on both)
WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/

GENERIC_TIMEZONE=Etc/UTC
TZ=Etc/UTC
