# No quotes around values: kustomize keeps them as part of the value.
# URL-safe characters only in the password (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
APP_SECRET=generate-with-openssl-rand-hex-32
# Keep the SAME value across migrations: 2FA secrets in the DB are encrypted with it.
TWO_FACTOR_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
